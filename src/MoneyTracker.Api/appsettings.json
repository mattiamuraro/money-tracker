{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "VaultUri": ""
  },
  "Jwt": {
    "Issuer": "MoneyTracker.Api",
    "Audience": "MoneyTracker",
    "ExpiryMinutes": "480"
  },
  "Auth": {
    "AllowRegistration": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://moneytracker.example.com"
    ]
  },
  "Security": {
    "LoginProtection": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "ExceptionDetails": {
      "IncludeExceptionDetails": false
    }
  }
}
