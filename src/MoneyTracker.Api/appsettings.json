{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "VaultUri": ""
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 2
  },
  "Jwt": {
    "Issuer": "MoneyTracker.Api",
    "Audience": "MoneyTracker",
    "ExpiryMinutes": "480"
  },
  "Auth": {
    "AllowRegistration": false,
    "RefreshToken": {
      "ExpiryDays": 14
    },
    "PasswordPolicy": {
      "MinimumLength": 12,
      "MaximumLength": 128,
      "PasswordHistoryCount": 5,
      "BlockedPasswords": [
        "password",
        "password123",
        "qwerty",
        "12345678",
        "admin123",
        "letmein"
      ]
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://moneytracker.example.com"
    ]
  },
  "Security": {
    "LoginProtection": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "ExceptionDetails": {
      "IncludeExceptionDetails": false
    },
    "RequestLimits": {
      "MaxRequestBodySizeBytes": 1048576,
      "MaxRequestHeadersTotalSizeBytes": 32768
    }
  }
}
