{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Worker": {
    "Resilience": {
      "MaxConsecutiveFailures": 5,
      "EscalationWindowMinutes": 30,
      "StopServiceOnEscalation": false,
      "EscalationCooldownMinutes": 15
    }
  }
}
